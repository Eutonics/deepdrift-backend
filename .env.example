# DeepDrift Secure Backend Configuration

# Redis Configuration
REDIS_URL=redis://localhost:6379
# Для облачного Redis (например, Redis Cloud):
# REDIS_URL=redis://username:password@host:port

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (разделяйте запятыми)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Для разработки добавьте:
# ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
MAX_MESSAGES_PER_MINUTE=60
MAX_OFFLINE_MESSAGES=1000
OFFLINE_MESSAGE_TTL=604800  # 7 дней в секундах

# Security
PROTOCOL_VERSION=2.0

# Logging
LOG_LEVEL=INFO
# Опции: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Monitoring (опционально)
ENABLE_METRICS=true
